{
  "name": "@picodash/dashpanel",
  "version": "0.0.0",
  "description": "A standalone React panel shell for arbitrary application content.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programbo/picodash.git",
    "directory": "packages/dashpanel"
  },
  "files": [
    "dist",
    "skills/docked-panel-shortcuts",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./integration": "./dist/integration.mjs",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css",
    "./resize-handles.css": "./dist/resize-handles.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --passWithNoTests",
    "test:package": "node tests/package-artifacts.mjs",
    "release:check": "vp check && vp test && vp run build && bun run test:package && bun pm pack --dry-run"
  },
  "dependencies": {
    "@picodash/nexus": "workspace:*",
    "@picodash/ui": "workspace:*",
    "@tanstack/react-hotkeys": "0.13.0",
    "lucide-react": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
