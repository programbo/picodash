{
  "name": "@picodash/store",
  "version": "0.0.0",
  "description": "The typed per-Panel state engine for Picodash.",
  "keywords": [
    "control-panel",
    "developer-tools",
    "state-management",
    "typescript",
    "zustand"
  ],
  "homepage": "https://github.com/programbo/picodash#readme",
  "bugs": {
    "url": "https://github.com/programbo/picodash/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/programbo/picodash"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "lint": "vp lint src tests --fix",
    "format": "vp fmt . --write",
    "release:check": "vp check && vp test && vp run build && bun pm pack --dry-run",
    "release:version": "bumpp --commit=false --tag=false --push=false",
    "prepublishOnly": "vp check && vp test && vp run build"
  },
  "dependencies": {
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "^12.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
