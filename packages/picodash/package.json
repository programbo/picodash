{
  "name": "@picodash/picodash",
  "version": "0.0.0",
  "description": "The Picodash facade for Nexus-backed DashPanel and DashStack compositions.",
  "keywords": [
    "tanstack-intent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/programbo/picodash.git",
    "directory": "packages/picodash"
  },
  "files": [
    "dist",
    "style.css",
    "skills/bind-controls"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./ui": "./dist/ui.mjs",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --passWithNoTests",
    "test:package": "node tests/package-artifacts.mjs",
    "release:check": "vp check && vp test && vp run build && bun run test:package && bun pm pack --dry-run"
  },
  "dependencies": {
    "@picodash/dashpanel": "workspace:*",
    "@picodash/dashstack": "workspace:*",
    "@picodash/nexus": "workspace:*",
    "@picodash/ui": "workspace:*",
    "lucide-react": "catalog:",
    "motion": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
