{
  "name": "@picodash/picodash",
  "version": "0.0.0",
  "description": "React control surfaces built from DashPanels, Dashlists, Dashlets, and reactive state.",
  "license": "MIT",
  "files": [
    "dist",
    "style.css"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./advanced": "./dist/advanced.mjs",
    "./catalog": "./dist/catalog.mjs",
    "./dashlet": "./dist/dashlet.mjs",
    "./ui": "./dist/ui.mjs",
    "./style.css": "./style.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test --passWithNoTests",
    "release:check": "vp check && vp run build && bun pm pack --dry-run"
  },
  "dependencies": {
    "@picodash/dashlist": "workspace:*",
    "@picodash/dashpanel": "workspace:*",
    "@picodash/store": "workspace:*",
    "@picodash/theme": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
