{
  "name": "@picodash/lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "vp lint src --fix",
    "format": "vp fmt src --write",
    "dev": "node scripts/dev.mjs",
    "build": "bun run picodash:build && next build",
    "check": "bun run picodash:build && tsc --noEmit",
    "picodash:build": "bun run --filter @picodash/nexus build && bun run --filter @picodash/ui build && bun run --filter @picodash/dashpanel build && bun run --filter @picodash/dashstack build && bun run --filter @picodash/picodash build && bun run --filter @picodash/dev-bridge build",
    "test:e2e": "playwright test",
    "test:e2e:cap": "playwright test --list",
    "artifacts:phone": "playwright test tests/phone-artifacts.spec.ts --workers=1",
    "test:dev-host": "node --test scripts/dev-host.test.mjs",
    "test": "vp test src"
  },
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@picodash/dashpanel": "workspace:*",
    "@picodash/dashstack": "workspace:*",
    "@picodash/dev-bridge": "workspace:*",
    "@picodash/nexus": "workspace:*",
    "@picodash/picodash": "workspace:*",
    "@picodash/ui": "workspace:*",
    "@tanstack/charts": "catalog:",
    "clsx": "catalog:",
    "motion": "catalog:",
    "next": "16.4.6",
    "react": "catalog:",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  }
}
