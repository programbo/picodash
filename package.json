{
  "name": "picodash",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^26.1.1",
      "typescript": "^6.0.3",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6",
      "vite-plus": "0.2.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-json-view-lite": "^2.5.0",
      "lucide-react": "^1.26.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@tsdown/css": "0.22.13",
      "tsdown": "0.22.13",
      "@playwright/test": "^1.61.1",
      "highlight.js": "^11.11.1",
      "zustand": "^5.0.14",
      "zod": "^4.4.3",
      "clsx": "^2.1.1",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/postcss": "^4.3.3",
      "postcss": "^8.5.22",
      "motion": "^12.42.2",
      "recharts": "^3.10.0",
      "react-dropzone": "^17.0.0",
      "tailwind-merge": "^3.6.0",
      "class-variance-authority": "^0.7.1",
      "shadcn": "^4.14.1",
      "tw-animate-css": "^1.4.0",
      "react-aria-components": "^1.19.0",
      "yaml": "^2.9.0",
      "@tailwindcss/typography": "^0.5.20"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint packages/store/src packages/dashpanel/src packages/dashlist/src packages/picodash/src packages/theme/src apps/web/src apps/lab/src --fix",
    "format": "vp fmt . --write",
    "ready": "bun run audit:high && bun run release:check && bun run artifacts:check && bun run evaluations:check && vp check && vp run -r test && vp run -r build && bun run evaluations:build && bun run test:e2e:lab:cap && bun run test:e2e:lab && bun run test:e2e:web",
    "audit:high": "bun audit --audit-level=high",
    "release:check": "bun run --filter @picodash/store release:check && bun run --filter @picodash/theme release:check && bun run --filter @picodash/dashlist release:check && bun run --filter @picodash/dashpanel release:check && bun run --filter @picodash/picodash release:check",
    "artifacts:check": "node scripts/check-agent-artifacts.mjs",
    "evaluations:check": "node scripts/check-evaluations.mjs",
    "evaluations:build": "node scripts/build-evaluation-seeds.mjs",
    "dev": "bun run --filter @picodash/web dev",
    "web": "bun run --filter @picodash/web dev",
    "lab": "bun run --filter @picodash/lab dev",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "picodash": "bun run web",
    "test:e2e": "bun run test:e2e:web",
    "test:e2e:web": "bun run --filter @picodash/web test:e2e",
    "test:e2e:lab": "bun run --filter @picodash/lab test:e2e",
    "test:e2e:lab:cap": "bun run --filter @picodash/lab test:e2e:cap",
    "port:reserve": "node scripts/worktree-ports.mjs reserve",
    "port:release": "node scripts/worktree-ports.mjs release",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@tsdown/css": "catalog:",
    "oxlint-tailwindcss": "1.6.0",
    "tsdown": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "fast-uri": "3.1.4",
    "postcss": "catalog:",
    "sharp": "0.35.3",
    "vite": "catalog:",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
