{
  "name": "picodash",
  "version": "0.0.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@types/node": "^26.2.0",
      "typescript": "^7.0.2",
      "vite": "npm:@voidzero-dev/vite-plus-core@0.2.8",
      "vite-plus": "0.2.8",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "react-json-view-lite": "^2.5.0",
      "lucide-react": "^1.26.0",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.4",
      "@tsdown/css": "0.22.14",
      "tsdown": "0.22.14",
      "@playwright/test": "^1.62.1",
      "@testing-library/react": "^16.3.0",
      "highlight.js": "^11.11.1",
      "zustand": "^5.0.14",
      "zod": "^4.4.3",
      "clsx": "^2.1.1",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/postcss": "^4.3.3",
      "postcss": "^8.5.26",
      "motion": "^12.42.2",
      "recharts": "^3.10.0",
      "react-dropzone": "^17.0.0",
      "@internationalized/date": "^3.12.3",
      "react-aria": "^3.51.0",
      "tailwind-merge": "^3.6.0",
      "class-variance-authority": "^0.7.1",
      "shadcn": "^4.14.1",
      "tw-animate-css": "^1.4.0",
      "react-aria-components": "^1.20.0",
      "@tanstack/charts": "0.12.0",
      "yaml": "^2.9.0",
      "@tailwindcss/typography": "^0.5.20",
      "jsdom": "^30.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "lint": "vp lint packages/nexus/src packages/ui/src packages/dashpanel/src packages/dashlist/src packages/picodash/src apps/web/src apps/lab/src --fix",
    "format": "vp fmt . --write",
    "ready": "bun run audit:high && bun run release:check && bun run artifacts:check && bun run evaluations:check && vp check && vp run -r test && vp run -r build && bun run evaluations:build && bun run test:e2e:lab:cap && bun run test:e2e:lab && bun run test:e2e:web",
    "audit:high": "bun audit --audit-level=high",
    "release:check": "bun run --filter @picodash/nexus release:check && bun run --filter @picodash/dev-bridge release:check && bun run --filter @picodash/ui release:check && bun run --filter @picodash/dashlist release:check && bun run --filter @picodash/dashpanel release:check && bun run --filter @picodash/picodash release:check",
    "artifacts:check": "node scripts/check-agent-artifacts.mjs && bun run motion:check",
    "motion:check": "node scripts/check-motion-policy.mjs",
    "evaluations:check": "node scripts/check-evaluations.mjs",
    "evaluations:build": "node scripts/build-evaluation-seeds.mjs",
    "dev": "bun run --filter @picodash/web dev",
    "web": "bun run --filter @picodash/web dev",
    "lab": "bun run --filter @picodash/lab dev",
    "deploy": "vercel",
    "deploy:prod": "vercel --prod",
    "picodash": "bun run web",
    "test:e2e": "bun run test:e2e:web",
    "test:e2e:web": "bun run --filter @picodash/web test:e2e",
    "test:e2e:lab": "bun run --filter @picodash/lab test:e2e",
    "test:e2e:lab:cap": "bun run --filter @picodash/lab test:e2e:cap",
    "artifacts:phone": "bun run --filter @picodash/lab artifacts:phone",
    "port:reserve": "node scripts/worktree-ports.mjs reserve",
    "port:release": "node scripts/worktree-ports.mjs release",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/react": "catalog:",
    "oxlint-tailwindcss": "1.8.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "nanoid": "3.3.18",
    "postcss": "catalog:",
    "sharp": "0.35.3",
    "undici": "8.10.0",
    "vite": "catalog:",
    "vitest": "4.1.10"
  },
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "packageManager": "bun@1.3.14"
}
