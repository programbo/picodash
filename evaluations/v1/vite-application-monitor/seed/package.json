{
  "name": "picodash-eval-vite-application-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port ${PORT:-4311}",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port ${PORT:-4311}",
    "acceptance": "bun run build && node --test acceptance/architecture.test.mjs && playwright test --config acceptance/playwright.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "typescript": "^7.0.2"
  }
}
